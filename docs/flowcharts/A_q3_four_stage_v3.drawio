        </mxCell>
        <mxCell id="A_q3_four_stage_v3_s2_right" value="水分由内部向表面迁移&lt;br&gt;后期受内部扩散控制" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#F28C28;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
