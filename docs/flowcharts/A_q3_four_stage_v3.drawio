        </mxCell>
        <mxCell id="A_q3_four_stage_v3_s2_note" value="干燥终点由全域最湿位置决定，而不是表面或平均水分" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFDF9;strokeColor=#F28C28;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
