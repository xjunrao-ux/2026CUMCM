        <mxCell id="A_q3_four_stage_v3_s1_b1" value="继承问题二的固定半径模型&lt;br&gt;从初始状态重新计算" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
