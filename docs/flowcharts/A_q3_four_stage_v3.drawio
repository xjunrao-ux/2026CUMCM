        <mxCell id="A_q3_four_stage_v3_s1_b2" value="前期采用附件1的 T0(t)、C0(t)&lt;br&gt;后期采用稳定环境边界" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
