        </mxCell>
        <mxCell id="q1_prep" value="检查时间序列与数据完整性&lt;br&gt;对 T∞(t)、C∞(t) 作分段线性插值" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4E5969;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
