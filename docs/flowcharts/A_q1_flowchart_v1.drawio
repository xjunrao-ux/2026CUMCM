          <mxGeometry x="205" y="465" width="510" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q1_t_eq" value="建立圆柱径向导热&lt;br&gt;有限体积方程" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#F28C28;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="205" y="550" width="510" height="65" as="geometry" />
        </mxCell>
        <mxCell id="q1_t_disc" value="后向 Euler：Δt=0.25 s&lt;br&gt;均匀网格：Δr=0.025 cm" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#F28C28;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="205" y="640" width="510" height="68" as="geometry" />
        </mxCell>
        <mxCell id="q1_t_solve" value="Thomas 算法求解&lt;br&gt;三对角方程组" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#F28C28;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="205" y="735" width="510" height="65" as="geometry" />
