          <mxGeometry x="885" y="542" width="510" height="65" as="geometry" />
        </mxCell>
        <mxCell id="q1_c_eq" value="建立非线性 Fick 扩散方程&lt;br&gt;表面内外阻力串联" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2F80ED;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="885" y="625" width="510" height="68" as="geometry" />
        </mxCell>
