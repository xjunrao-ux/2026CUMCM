          <mxGeometry x="865" y="710" width="510" height="82" as="geometry" />
        </mxCell>
        <mxCell id="q3_reconstruct" value="重构中心、内部节点与表面值&lt;br&gt;计算全域最大水分 Cmax" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4E5969;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="830" y="825" width="580" height="68" as="geometry" />
        </mxCell>
        <mxCell id="q3_dry" value="max C(r,t) &amp;lt; 0.15 kg/kg？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4E5969;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="550" y="975" width="500" height="88" as="geometry" />
