        <mxCell id="q3_title" value="问题三：全烘干过程自适应推进与终止判定流程" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#1F2937;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="180" y="12" width="1240" height="42" as="geometry" />
        </mxCell>
        <mxCell id="q3_input" value="附件1环境数据、附录3经验公式&lt;br&gt;沿用第二问固定半径水热耦合模型" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4E5969;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="400" y="65" width="800" height="65" as="geometry" />
        </mxCell>
        <mxCell id="q3_prep" value="0～4 h采用分段线性边界&lt;br&gt;4 h后采用3～4 h环境参数时间加权平均值" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4E5969;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="400" y="150" width="800" height="65" as="geometry" />
        </mxCell>
        <mxCell id="q3_init" value="生成表面加密有限体积网格&lt;br&gt;初始化温度场、水分场及 Cmax=2.55 kg/kg" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4E5969;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="400" y="235" width="800" height="72" as="geometry" />
        </mxCell>
        <mxCell id="q3_time_branch" value="当前时间 t ≤ 4 h？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="250" y="415" width="320" height="82" as="geometry" />
        </mxCell>
        <mxCell id="q3_measured" value="是：使用附件1&lt;br&gt;插值环境边界" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="155" y="535" width="230" height="68" as="geometry" />
        </mxCell>
        <mxCell id="q3_plateau" value="否：使用3～4 h&lt;br&gt;平均恒定边界" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="435" y="535" width="230" height="68" as="geometry" />
        </mxCell>
        <mxCell id="q3_dt" value="选择 Δt&lt;br&gt;前4 h：1 s；稳定期：30 s&lt;br&gt;Cmax&amp;lt;0.152：1 s" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="205" y="650" width="410" height="90" as="geometry" />
        </mxCell>
        <mxCell id="q3_align" value="对齐4 h切换点&lt;br&gt;及每个60 s输出时刻" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="205" y="790" width="410" height="72" as="geometry" />
        </mxCell>
        <mxCell id="q3_picard" value="以 Tⁿ、Cⁿ 作为 Picard 初值" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F7F8FA;strokeColor=#4E5969;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="830" y="415" width="580" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q3_heat" value="由 C 更新热物性&lt;br&gt;隐式求解温度场 T^(m+1)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF7EE;strokeColor=#F28C28;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="830" y="505" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="q3_moist" value="由 T、C 更新 D(T,C)&lt;br&gt;隐式求解水分场 C^(m+1)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F3F8FF;strokeColor=#2F80ED;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="830" y="605" width="580" height="70" as="geometry" />
        </mxCell>
