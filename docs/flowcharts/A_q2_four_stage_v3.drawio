        <mxCell id="A_q2_four_stage_v3_title" value="问题二｜温湿相关物性驱动的非线性水热耦合" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#1F2937;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="18" width="1000" height="44" as="geometry" />
        </mxCell>
        <mxCell id="A_q2_four_stage_v3_subtitle" value="从条件定义到物理机制、数学表达与数值输出的四阶段流程" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=17;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="140" y="70" width="920" height="34" as="geometry" />
        </mxCell>
        <mxCell id="A_q2_four_stage_v3_s1_b1" value="沿用一维径向长圆柱&lt;br&gt;半径保持不变" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="105" y="205" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="A_q2_four_stage_v3_s1_b2" value="给定初始温度与水分&lt;br&gt;采用附录3物性关系" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="450" y="205" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="A_q2_four_stage_v3_s1_b3" value="由附件1构造 T0(t)、C0(t)&lt;br&gt;中心对称、表面对流" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="795" y="205" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="A_q2_four_stage_v3_s2_left" value="水分改变热物性&lt;br&gt;进而影响药材温度场" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#F28C28;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="130" y="485" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="A_q2_four_stage_v3_s2_right" value="温度与水分共同改变扩散能力&lt;br&gt;并反馈水分迁移" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#F28C28;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="670" y="485" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="A_q2_four_stage_v3_s2_note" value="形成“水分 → 温度 → 扩散 → 水分”的双向物性耦合闭环" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFDF9;strokeColor=#F28C28;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="635" width="680" height="55" as="geometry" />
        </mxCell>
        <mxCell id="A_q2_four_stage_v3_s3_left" value="变物性热传导模型&lt;br&gt;热参数随水分状态更新" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2F80ED;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
