        <mxCell id="A_q4_four_stage_v3_s1_b1" value="附件2给出时变半径 R(t)&lt;br&gt;假设药材均匀径向收缩" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
