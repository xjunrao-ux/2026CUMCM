        </mxCell>
        <mxCell id="q2_input" value="附件1环境数据、附录3经验公式&lt;br&gt;固定半径 R=2 cm 与初始状态" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4E5969;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="420" y="65" width="760" height="65" as="geometry" />
        </mxCell>
        <mxCell id="q2_prep" value="检查数据并线性插值&lt;br&gt;生成 0～3 h 的逐秒环境边界" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4E5969;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="420" y="150" width="760" height="65" as="geometry" />
        </mxCell>
        <mxCell id="q2_init" value="建立160个向表面加密的径向控制体&lt;br&gt;初始化 T⁰=28 ℃、C⁰=2.55 kg/kg，Δt=0.5 s" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4E5969;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="370" y="235" width="860" height="72" as="geometry" />
        </mxCell>
        <mxCell id="q2_step" value="读取当前 T∞(t)、C∞(t)&lt;br&gt;令 T^0=T^n，C^0=C^n" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F7F8FA;strokeColor=#4E5969;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="500" y="400" width="600" height="68" as="geometry" />
        </mxCell>
        <mxCell id="q2_heat_prop" value="由 C^m 更新&lt;br&gt;ρ(C)、cp(C)、k(C)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF7EE;strokeColor=#F28C28;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="300" y="510" width="450" height="75" as="geometry" />
        </mxCell>
        <mxCell id="q2_heat_solve" value="组装温度有限体积方程&lt;br&gt;Thomas 求 T^(m+1)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF7EE;strokeColor=#F28C28;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="850" y="510" width="450" height="75" as="geometry" />
        </mxCell>
        <mxCell id="q2_moist_prop" value="由 T^(m+1)、C^m&lt;br&gt;更新 D(T,C)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F3F8FF;strokeColor=#2F80ED;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="300" y="640" width="450" height="75" as="geometry" />
        </mxCell>
        <mxCell id="q2_moist_solve" value="组装水分有限体积方程&lt;br&gt;Thomas 求 C^(m+1)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F3F8FF;strokeColor=#2F80ED;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="850" y="640" width="450" height="75" as="geometry" />
        </mxCell>
        <mxCell id="q2_conv" value="||ΔT||∞&amp;lt;10^(-8) 且 ||ΔC||∞&amp;lt;10^(-10)？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4E5969;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="515" y="770" width="570" height="92" as="geometry" />
        </mxCell>
        <mxCell id="q2_accept" value="接受 T^(n+1)、C^(n+1)&lt;br&gt;重构中心值与真实表面值" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4E5969;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="500" y="875" width="600" height="62" as="geometry" />
        </mxCell>
        <mxCell id="q2_end" value="每1 s保存一次；t = 10800 s？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4E5969;strokeWidth=2;fontSize=18;fontStyle=0;fontColor=#1F2937;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="550" y="975" width="500" height="88" as="geometry" />
        </mxCell>
        <mxCell id="q2_output" value="插值到 0.1 cm 网格，生成表3、表4与 result2.xlsx&lt;br&gt;进行综合加密、水分守恒、范围及单调性验证" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F7F8FA;strokeColor=#4E5969;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#1F2937;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1">
